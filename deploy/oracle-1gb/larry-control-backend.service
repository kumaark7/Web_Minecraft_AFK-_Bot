[Unit]
Description=Larry Control Backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/larry-control/apps/backend
EnvironmentFile=/etc/larry-control/backend.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
User=www-data
Group=www-data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
